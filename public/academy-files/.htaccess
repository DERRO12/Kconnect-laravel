# K-Academy files (old kacademy/assets). Never run scripts from here.
Options -Indexes
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
