APP_NAME=K-Connect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kconnect.kibokogroup.com
# Leave empty to use php.ini's date.timezone, exactly like the old site
APP_TIMEZONE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# K-Connect database (unchanged, existing tables)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kiboko_intranet_portal
DB_USERNAME=kiboko_intranet_portal
DB_PASSWORD=

# K-Academy database (user sync)
KA_DB_HOST=localhost
KA_DB_PORT=3306
KA_DB_DATABASE=kiboko_academy
KA_DB_USERNAME=kiboko_academy
KA_DB_PASSWORD=

# Files, not database tables, so no new tables are needed
SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Gmail SMTP used by the IT / rewards / birthday emails
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=kibokohr@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=kibokohr@gmail.com
MAIL_FROM_NAME=K-Connect
MAIL_REPLY_TO=it-support@kibokogroup.com
MAIL_VERIFY_PEER=false

# Set to true while developing to turn PHP warnings into errors
KC_STRICT_ERRORS=false

# Same 5-minute data cache as the old site (CACHE_ENABLED in config.php)
KC_CACHE_ENABLED=true
